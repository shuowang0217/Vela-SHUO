<?xml version="1.0" encoding="utf-8"?>
<!-- SystemUI retains its notification header and outer shell. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="50dp">
    <ImageView android:id="@+id/vela_notice_art"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null" />
    <ImageView android:id="@+id/vela_notice_scrim"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageView android:id="@+id/vela_notice_icon"
            android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/vela_notification_icon_clip"
            android:clipToOutline="true" android:scaleType="centerCrop"
            android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:gravity="center_vertical"
            android:orientation="vertical">
            <TextView android:id="@+id/vela_notice_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="sans" android:textStyle="bold"
                android:textColor="#243541" android:textSize="13sp" />
            <TextView android:id="@+id/vela_notice_rates"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="sans"
                android:textColor="#243541" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
